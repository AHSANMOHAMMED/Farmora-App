rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function active() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).get('isSuspended', false) != true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).get('isDeleted', false) != true;
    }
    function admin() {
      return active() && (
        request.auth.token.admin == true
        || (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isVerified == true)
      );
    }

    function order(orderId) {
      return firestore.get(/databases/(default)/documents/orders/$(orderId)).data;
    }
    function orderParty(orderId) {
      return active() && (
        order(orderId).buyerId == request.auth.uid
        || order(orderId).farmerId == request.auth.uid
        || order(orderId).get('transporterId', '') == request.auth.uid
      );
    }
    function validImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow write: if active() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Farmers can upload product images before the product doc exists.
    match /product_images/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if active() && request.auth.uid == userId
        && validImageUpload();
      allow delete: if active() && request.auth.uid == userId;
    }

    // Farmers can upload product images for an existing listing.
    match /products/{productId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if active()
        && firestore.get(/databases/(default)/documents/products/$(productId)).data.farmerId == request.auth.uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
    }

    // Harvest videos: owner farmer can upload/delete, any signed-in user can view.
    match /product_videos/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if active() && request.auth.uid == userId
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if active() && request.auth.uid == userId;
    }

    // Dispute evidence photos (owner uploads, admins can review).
    match /disputes/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow write: if active() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if active() && request.auth.uid == userId;
    }

    // Bank-deposit slips: only the order's buyer uploads (file name prefixed
    // with their uid); only parties to the order and admins can read. Slips
    // are payment evidence, so they are never overwritten or deleted.
    match /payment_slips/{orderId}/{fileName} {
      allow read: if orderParty(orderId) || admin();
      allow create: if active()
        && order(orderId).buyerId == request.auth.uid
        && fileName.matches(request.auth.uid + '_.+')
        && validImageUpload();
      allow update, delete: if false;
    }

    // Photos sent in an order chat, stored per sender.
    match /chat/{orderId}/{senderId}/{fileName} {
      allow read: if orderParty(orderId) || admin();
      allow create: if request.auth != null && request.auth.uid == senderId
        && orderParty(orderId)
        && validImageUpload();
      allow update, delete: if false;
    }

    // Transport providers can upload verification documents
    match /verification/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow write: if active() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
