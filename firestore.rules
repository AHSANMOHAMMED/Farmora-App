rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users Collection ──────────────────────────────────
    match /users/{userId} {
      // Anyone can read user profiles (for display names, etc.)
      allow read: if true;

      // Only the authenticated user can create their own profile
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['id', 'role', 'displayName'])
                    && request.resource.data.id == userId;

      // Only the user can update their own profile
      // Admins can update any user (suspend/unsuspend)
      allow update: if request.auth != null
                    && (request.auth.uid == userId
                        || request.auth.token.admin == true);

      // Only the user can delete their own account
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // ─── Products Collection ───────────────────────────────
    match /products/{productId} {
      // Anyone can read products (public marketplace)
      allow read: if true;

      // Only authenticated farmers can create products
      allow create: if request.auth != null
                    && request.resource.data.farmerId == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'farmerId', 'name', 'category', 'priceMinor',
                         'quantityAvailable', 'unit', 'location'
                       ]);

      // Only the farmer who owns the product can update it
      allow update: if request.auth != null
                    && resource.data.farmerId == request.auth.uid;

      // Only the farmer who owns the product can delete it
      allow delete: if request.auth != null
                    && resource.data.farmerId == request.auth.uid;
    }

    // ─── Orders Collection ─────────────────────────────────
    match /orders/{orderId} {
      // Buyers can read their own orders
      // Farmers can read orders for their products
      allow read: if request.auth != null
                  && (resource.data.buyerId == request.auth.uid
                      || resource.data.farmerId == request.auth.uid);

      // Only authenticated buyers can create orders
      allow create: if request.auth != null
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'buyerId', 'farmerId', 'items', 'totalMinor', 'status'
                       ]);

      // Buyers can update delivery address and cancel
      // Farmers can update order status (confirm/reject/ship)
      allow update: if request.auth != null
                    && (resource.data.buyerId == request.auth.uid
                        || resource.data.farmerId == request.auth.uid);

      // Buyers can cancel/delete their own orders
      allow delete: if request.auth != null
                    && resource.data.buyerId == request.auth.uid
                    && resource.data.status in ['pending', 'confirmed'];
    }

    // ─── Market Prices Collection ──────────────────────────
    match /market_prices/{priceId} {
      // Anyone can read market prices (public data)
      allow read: if true;

      // Only admin can write market prices
      // (In production, use Firebase Admin SDK or Cloud Functions)
      allow write: if request.auth != null
                   && request.auth.token.admin == true;
    }

    // ─── Transport Jobs Collection ─────────────────────────
    match /transport_jobs/{jobId} {
      // Anyone can read transport jobs (public marketplace)
      allow read: if true;

      // Farmers and buyers can create transport jobs
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                         'pickupAddress', 'dropoffAddress', 'offeredFeeMinor', 'status'
                       ]);

      // Transporters can accept/update jobs
      // Farmers/buyers who created the job can update it
      allow update: if request.auth != null;

      // Only the job creator or transporter can delete
      allow delete: if request.auth != null;
    }

    // ─── Reviews Collection ────────────────────────────────
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;

      // Only authenticated users can create reviews
      allow create: if request.auth != null
                    && request.resource.data.reviewerId == request.auth.uid;

      // Only the reviewer can update/delete their own review
      allow update: if request.auth != null
                    && resource.data.reviewerId == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.reviewerId == request.auth.uid;
    }

    // ─── Messages Collection ───────────────────────────────
    match /messages/{messageId} {
      // Only sender and receiver can read messages
      allow read: if request.auth != null
                  && (resource.data.senderId == request.auth.uid
                      || resource.data.receiverId == request.auth.uid);

      // Only authenticated users can send messages
      allow create: if request.auth != null
                    && request.resource.data.senderId == request.auth.uid;

      // No updates or deletes for messages (immutable)
      allow update, delete: if false;
    }
  }
}
