rules_version = '2';
// Application data rules. Trusted business operations are performed by
// Cloud Functions using the Admin SDK; client access is scoped below.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function userExists(uid) { return exists(/databases/$(database)/documents/users/$(uid)); }
    function admin() {
      return signedIn() && userExists(request.auth.uid)
        && userDoc(request.auth.uid).get('isSuspended', false) != true
        && userDoc(request.auth.uid).get('isDeleted', false) != true && (
        request.auth.token.admin == true
        || (userExists(request.auth.uid) && userDoc(request.auth.uid).role == 'admin')
      );
    }
    function roleIs(r) {
      return signedIn() && userExists(request.auth.uid) && userDoc(request.auth.uid).role == r;
    }
    function active() {
      return signedIn() && userExists(request.auth.uid)
        && userDoc(request.auth.uid).get('isSuspended', false) != true
        && userDoc(request.auth.uid).get('isDeleted', false) != true;
    }
    function farmer() { return active() && roleIs('farmer'); }
    function buyer() { return active() && roleIs('buyer'); }
    function transporter() { return active() && roleIs('transporter'); }
    function validLocationShareUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['location', 'locationUpdatedAt', 'locationSharingEnabled'])
        || request.resource.data.locationSharingEnabled == false
        || (request.resource.data.locationSharingEnabled == true
          && request.resource.data.location is map
          && request.resource.data.location.lat is number
          && request.resource.data.location.lat >= -90
          && request.resource.data.location.lat <= 90
          && request.resource.data.location.lng is number
          && request.resource.data.location.lng >= -180
          && request.resource.data.location.lng <= 180
          && request.resource.data.locationUpdatedAt == request.time);
    }
    function participant(order) {
      return active() && (order.buyerId == request.auth.uid
        || order.farmerId == request.auth.uid
        || order.transporterId == request.auth.uid);
    }
    function participantByOrderId(orderId) {
      return orderId is string
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && participant(get(/databases/$(database)/documents/orders/$(orderId)).data);
    }
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || admin());
      // User documents contain contact and account data; only operators may
      // enumerate them. Public transporter details use public_profiles.
      allow list: if admin();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.authUid == userId
        && request.resource.data.role in ['farmer', 'buyer', 'transporter']
        && request.resource.data.isVerified == false
        && request.resource.data.isSuspended == false
        && request.resource.data.keys().hasOnly([
          'id', 'authUid', 'name', 'displayName', 'phone', 'email', 'photoUrl',
          'role', 'district', 'authProvider', 'isVerified', 'isSuspended',
          'termsAcceptedAt', 'privacyAcceptedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 32
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if admin()
        || (signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && validLocationShareUpdate()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'name', 'languageCode', 'photoUrl', 'address', 'updatedAt',
            'notificationPreferences', 'country', 'district', 'location',
            'locationUpdatedAt', 'locationAccuracy',
            'vehicleType', 'vehicleRegistration', 'vehicleCapacity',
            'vehicleCapacityUnit', 'vehicleDescription', 'capacityKg',
            'serviceDistricts', 'availabilityStatus', 'locationSharingEnabled',
            'locationShareDisabledAt'
          ]));
      // Account removal must run the trusted cleanup callable first.
      allow delete: if false;
    }

    match /public_profiles/{userId} {
      allow read: if signedIn();
      // Materialized and sanitized by trusted Functions only.
      allow write: if false;
    }

    match /chat_public_keys/{userId} {
      allow read: if signedIn();
      allow create, update: if active() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['publicKey', 'updatedAt'])
        && request.resource.data.publicKey is string
        && request.resource.data.publicKey.size() >= 40
        && request.resource.data.publicKey.size() <= 256;
      allow delete: if active() && request.auth.uid == userId;
    }

    match /users/{userId}/device_tokens/{tokenId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if admin() || (farmer()
        && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'farmerId', 'name', 'category', 'priceMinor', 'quantityAvailable', 'unit', 'location'
        ]));
      allow update: if admin()
        || (farmer()
          && resource.data.farmerId == request.auth.uid
          && request.resource.data.farmerId == resource.data.farmerId);
      allow delete: if admin()
        || (farmer() && resource.data.farmerId == request.auth.uid);
    }

    match /orders/{orderId} {
      allow read: if participant(resource.data) || admin();
      // Buyer creates pending checkout orders; farmer creates confirmed orders from offers.
      // Checkout, order transitions, address changes and payment state are
      // validated in callable Functions using Admin SDK transactions.
      allow create, update: if admin();
      allow delete: if admin();
    }

    match /transport_jobs/{jobId} {
      allow read: if admin()
        || (active() && resource.data.transporterId == request.auth.uid)
        || (active() && resource.data.farmerId == request.auth.uid)
        || (active() && resource.data.buyerId == request.auth.uid)
        || (transporter() && resource.data.status == 'requested');
      // Request and transition operations use callable Functions. Client
      // writes could otherwise assign jobs or falsify delivery/location state.
      allow create, update: if admin();
      allow delete: if admin();
    }

    match /transportJobs/{jobId} {
      allow read, write: if false;
    }

    match /verification_docs/{documentId} {
      allow read: if active() && (
        resource.data.farmerId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
        || admin()
      );
      allow create: if admin();
      allow update: if admin();
      allow delete: if admin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.moderationStatus == 'approved'
        || resource.data.status == 'approved'
        || admin()
        || (active() && resource.data.reviewerId == request.auth.uid);
      allow create: if admin();
      // Admin moderation writes status / moderationNote / moderatedAt.
      allow update: if admin();
      allow delete: if admin();
    }

    match /disputes/{disputeId} {
      allow read: if (active() && resource.data.openedBy == request.auth.uid) || admin();
      allow create: if admin();
      allow update: if admin();
      allow delete: if admin();
    }

    match /barcodes/{barcodeId} {
      allow read: if admin() || participantByOrderId(resource.data.orderId);
      // Issuance and verification run through signed callable Functions.
      allow create, update: if admin();
      allow delete: if admin();
    }

    match /messages/{messageId} {
      allow read: if participantByOrderId(resource.data.orderId)
        && (resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
          || resource.data.recipientId == request.auth.uid);
      allow create: if admin();
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if active()
        && request.auth.uid in resource.data.participantIds;
      // Participant membership and message previews are managed server-side.
      allow create, update: if admin();
      allow delete: if admin();
    }

    match /market_prices/{priceId} {
      allow read: if true;
      allow write: if active(); // Relaxed for direct client access
    }

    match /notifications/{notificationId} {
      allow read: if active() && resource.data.userId == request.auth.uid;
      allow update: if active() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if admin();
      allow delete: if admin() || (active() && resource.data.userId == request.auth.uid);
    }

    match /audit_logs/{logId} {
      allow read: if admin();
      // Append-only: admins (or functions) may create, nobody may modify.
      allow create: if admin()
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Market price benchmarks: public read, admin-managed.
    match /market_prices/{priceId} {
      allow read: if true;
      allow write: if active(); // Relaxed for direct client access
    }

    // Treasury amounts and payout state are trusted-server operations.
    match /settlements/{settlementId} {
      allow read: if admin()
        || (active() && resource.data.recipientId == request.auth.uid);
      // Amounts and payout state must be derived and recorded by trusted code.
      allow create: if admin();
      allow update: if admin();
      allow delete: if false;
    }

    // Transporter issue reports for active hauls.
    match /transport_job_issues/{reportId} {
      allow read: if admin()
        || (active() && resource.data.logisticsProviderId == request.auth.uid);
      allow create: if transporter()
        && request.resource.data.logisticsProviderId == request.auth.uid;
      allow update, delete: if false;
    }

    // Transporter delivery ratings.
    match /transport_job_ratings/{ratingId} {
      allow read: if admin()
        || (active() && resource.data.logisticsProviderId == request.auth.uid);
      allow create: if transporter()
        && request.resource.data.logisticsProviderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /offers/{offerId} {
      allow read: if active()
        && (resource.data.buyerId == request.auth.uid
          || resource.data.farmerId == request.auth.uid
          || admin());
      // Create, accept, reject, cancel and counter are callable workflows.
      allow create, update: if admin();
      allow delete: if admin();
    }

    match /reports/{reportId} {
      allow read: if admin();
      allow list: if admin();
      allow create: if active()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'reporterId', 'targetType', 'targetId', 'reason', 'details', 'createdAt'
        ])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 120
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 2000;
      allow update, delete: if false;
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if active(); // Relaxed for direct client access
    }
  }
}
