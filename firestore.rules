rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{phone} {
      allow get: if request.auth != null
        && resource.data.authUid == request.auth.uid;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.phone == phone
        && request.resource.data.role in ['farmer', 'buyer', 'transporter'];
      allow update: if request.auth != null
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }
    match /authUsers/{userId} {
      allow create, get: if request.auth != null && request.auth.uid == userId;
      allow list, update, delete: if false;
    }
  }
}