# Farmora environment configuration (NO real values — copy to .env and fill in).
# Separate Firebase projects + bundle IDs per environment:
# dev / staging / prod (see .firebaserc).

# ── Firebase ──────────────────────────────────────────────
# firebase_options.dart is generated via `flutterfire configure`.
# FIREBASE_PROJECT_DEV=farmora-dev
# FIREBASE_PROJECT_STAGING=farmora-staging
# FIREBASE_PROJECT_PROD=farmora-prod
# ANDROID_PACKAGE_DEV=com.example.farmora.dev
# ANDROID_PACKAGE_PROD=com.example.farmora
# IOS_BUNDLE_DEV=com.example.farmora.dev
# IOS_BUNDLE_PROD=com.example.farmora

# ── Firebase Storage ──────────────────────────────────────
# STORAGE_BUCKET_DEV=farmora-dev.appspot.com
# STORAGE_BUCKET_PROD=farmora-prod.appspot.com

# ── Push notifications (FCM) ──────────────────────────────
# Configure APNs (iOS) + Web Push certs in the Firebase console.
# FCM_VAPID_KEY=

# ── Maps (optional — progress widget used until set) ──
# Pass at build time: flutter run --dart-define=GOOGLE_MAPS_API_KEY=...
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY_ANDROID=
# GOOGLE_MAPS_API_KEY_IOS=

# ── Payments (PayHere — COD used until merchant creds exist) ──
# Cloud Functions env:
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_SANDBOX=true
# PAYHERE_WEBHOOK_SECRET=

# ── Messaging / barcode signing (Cloud Functions env) ────
# BARCODE_SIGNING_SECRET=<min-32-char-random-string>

# ── App Check ─────────────────────────────────────────────
# Debug builds use the debug App Check provider.
# Production: enable Play Integrity (Android) and DeviceCheck (iOS)
# in the Firebase console, then ship non-debug builds.

# ── Analytics / crash reporting ───────────────────────────
# ANALYTICS_ENABLED=true

# ── Support contacts ──────────────────────────────────────
# SUPPORT_EMAIL=support@farmora.app
# SUPPORT_PHONE=+94112345678
